import boto3
import json
import logging
from botocore.exceptions import NoCredentialsError, ClientError

# ==============================================================================
# MASTER SWITCH: Set to False to connect to REAL AWS Environment via Boto3
# ==============================================================================
MOCK_MODE = True 

# Configure professional logging for identity auditing
logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')

class IAMIdentityAuditor:
    """
    Description: Audits the AWS IAM Account Password Policy.
    Objective: Enforce strong credential management to prevent brute-force attacks.
    """
    def __init__(self):
        if not MOCK_MODE:
            # Initialize IAM client for real AWS API calls
            self.iam = boto3.client('iam')

    def fetch_password_policy(self):
        """Retrieves password policy settings from Mock or Real API."""
        if MOCK_MODE:
            # Professional Mock: Simulating a weak password policy
            return {
                'PasswordPolicy': {
                    'MinimumPasswordLength': 8, # TOO SHORT
                    'RequireSymbols': False,    # DANGEROUS
                    'PasswordReusePrevention': 0 # NO HISTORY CHECK
                }
            }
        else:
            try:
                return self.iam.get_account_password_policy()
            except ClientError as e:
                # If no policy is set, AWS raises a NoSuchEntity error
                logging.error(f"No password policy found: {e}")
                return None

    def run_identity_audit(self):
        logging.info(f"Auditing IAM Password Policy (Mode: {'MOCK' if MOCK_MODE else 'REAL'})...")
        policy_data = self.fetch_password_policy()
        
        if not policy_data:
            return {"Status": "CRITICAL", "Finding": "No Password Policy Defined!"}

        policy = policy_data.get('PasswordPolicy', {})
        length = policy.get('MinimumPasswordLength', 0)
        symbols = policy.get('RequireSymbols', False)
        
        # Security Logic: Define what a 'Strong' policy looks like
        is_strong = (length >= 14) and symbols
        
        return {
            "Min_Length": length,
            "Symbols_Required": symbols,
            "Compliance_Status": "PASS" if is_strong else "FAIL",
            "Severity": "OK" if is_strong else "HIGH",
            "Mitre_Mapping": "T1110 (Brute Force)",
            "Remediation": "Update IAM Password Policy to require 14+ characters and special symbols."
        }

if __name__ == "__main__":
    auditor = IAMIdentityAuditor()
    report = auditor.run_identity_audit()
    
    print("\n" + "🔑 " * 10)
    print("  IAM PASSWORD POLICY AUDIT")
    print("🔑 " * 10)
    print(json.dumps(report, indent=4))