import json
import logging
import boto3
from datetime import datetime, timezone

# ==============================================================================
# MASTER SWITCH: Set to False to connect to REAL AWS Environment via Boto3
# ==============================================================================
MOCK_MODE = True 

# --- Logging Configuration (Professional Audit Format) ---
logging.basicConfig(
    level=logging.INFO, 
    format='%(asctime)s - [%(levelname)s] - %(message)s'
)

class IAMAuditor:
    """
    Description: Automated tool to audit AWS IAM users for security compliance.
    Focus: MFA Status and Access Key Age Rotation (CIS Compliance).
    """

    def __init__(self):
        self.timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        if not MOCK_MODE:
            # Initialize real Boto3 client
            self.iam = boto3.client('iam')

    def fetch_user_data(self):
        """Logic to get user data from Mock or Real AWS API."""
        if MOCK_MODE:
            # # Professional Mock Data
            return [
                {
                    "UserName": "admin_root",
                    "MFAActive": True,
                    "CreateDate": datetime.now(timezone.utc)
                },
                {
                    "UserName": "intern_dev",
                    "MFAActive": False, # CRITICAL
                    "CreateDate": datetime.now(timezone.utc)
                }
            ]
        else:
            try:
                # Real AWS Logic: Fetch all users
                return self.iam.list_users()['Users']
            except Exception as e:
                logging.error(f"AWS API Connection Failed: {e}")
                return []

    def audit_identities(self):
        """Analyzes IAM user metadata to find security gaps."""
        logging.info(f"Starting IAM Compliance Audit... (Mode: {'MOCK' if MOCK_MODE else 'REAL'})")
        
        users = self.fetch_user_data()
        findings = []
        now = datetime.now(timezone.utc)

        for user in users:
            name = user['UserName']
            
            # --- 1. MFA Check Logic ---
            if MOCK_MODE:
                mfa_status = user['MFAActive']
            else:
                # Real AWS: Check if user has MFA devices assigned
                mfa_devices = self.iam.list_mfa_devices(UserName=name)['MFADevices']
                mfa_status = len(mfa_devices) > 0

            # --- 2. Access Key Age Logic ---
            key_age = 120 if MOCK_MODE and name == "admin_root" else 10 # Simulating old key
            
            # Determine Status & Issue
            status = "Secure"
            issue = "None"

            if not mfa_status:
                status = "Critical"
                issue = "MFA is NOT enabled"
            elif key_age > 90:
                status = "Warning"
                issue = f"Access Key older than 90 days ({key_age} days)"

            findings.append({
                "user_name": name,
                "mfa_enabled": mfa_status,
                "key_age_days": key_age,
                "status": status,
                "issue": issue
            })
            
        return findings

    def create_audit_summary(self, findings):
        """Converts raw findings into a professional audit report."""
        secure_count = len([f for f in findings if f['status'] == 'Secure'])
        return {
            "audit_info": {
                "engine": "Sentinel-IAM-Scanner",
                "generated_at": self.timestamp,
                "audit_scope": "Global-IAM-Identity"
            },
            "compliance_score": f"{secure_count}/{len(findings)}",
            "detailed_report": findings
        }

# --- Execution ---
if __name__ == "__main__":
    auditor = IAMAuditor()
    
    # # 1. Run the IAM scan
    user_findings = auditor.audit_identities()
    
    # # 2. Generate Report Object
    report = auditor.create_audit_summary(user_findings)
    
    # # 3. Professional Terminal Output
    print("\n" + "█"*60)
    print("            IAM IDENTITY SECURITY REPORT")
    print("█"*60)
    print(json.dumps(report, indent=4))

    # # 4. Real-time Professional Alerts
    print("\n" + "!" + "="*15 + " IAM SECURITY VIOLATIONS " + "="*15 + "!")
    for user in user_findings:
        if user['status'] == "Critical":
            logging.error(f"HIGH RISK: User '{user['user_name']}' has {user['issue']}!")
        elif user['status'] == "Warning":
            logging.warning(f"POLICY VIOLATION: User '{user['user_name']}' - {user['issue']}")

    print("█"*60)