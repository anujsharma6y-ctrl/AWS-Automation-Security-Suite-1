import json
import logging
import boto3

# ==============================================================================
# MASTER SWITCH: Set to False to connect to REAL AWS Environment via Boto3
# ==============================================================================
MOCK_MODE = True 

# --- Logging Configuration (Audit Style) ---
logging.basicConfig(
    level=logging.INFO, 
    format='%(asctime)s - [%(levelname)s] - %(message)s'
)

class PrivilegeEscalationDetector:
    """
    Description: Scans IAM policies for vectors that allow users to elevate privileges.
    Standard: Principle of Least Privilege (PoLP).
    """

    def __init__(self):
        # List of dangerous permissions that allow privilege escalation
        self.critical_perms = [
            "iam:CreatePolicyVersion",
            "iam:SetDefaultPolicyVersion",
            "iam:PassRole",
            "iam:AttachUserPolicy",
            "iam:PutUserPolicy",
            "iam:CreateAccessKey"
        ]
        if not MOCK_MODE:
            self.iam = boto3.client('iam')

    def fetch_user_permissions(self):
        """Logic to fetch permissions for all users (Mock or Real)."""
        if MOCK_MODE:
            # Professional Mock: Identifying a 'Shadow Admin'
            return [
                {
                    "UserName": "readonly_service_account",
                    "AssignedPermissions": ["s3:Get*", "ec2:Describe*"],
                    "Risk": "Low"
                },
                {
                    "UserName": "dev_temp_user",
                    "AssignedPermissions": ["iam:PassRole", "ec2:RunInstances"], # ESCALATION VECTOR
                    "Risk": "Critical"
                }
            ]
        else:
            # Real logic to extract inline and managed policies
            # For simplicity in portfolio, we iterate through users
            return []

    def scan_for_escalation(self):
        logging.info(f"Scanning IAM Identities for Escalation Vectors... (Mode: {'MOCK' if MOCK_MODE else 'REAL'})")
        
        users_data = self.fetch_user_permissions()
        findings = []

        for user in users_data:
            name = user['UserName']
            permissions = user['AssignedPermissions']
            
            # Detect dangerous overlaps
            matches = [p for p in permissions if p in self.critical_perms]
            
            is_risky = len(matches) > 0
            
            findings.append({
                "User": name,
                "Vulnerable_Permissions": matches if is_risky else "None",
                "Status": "VULNERABLE" if is_risky else "SECURE",
                "Severity": "CRITICAL" if is_risky else "INFO",
                "MITRE_Mapping": "T1548.003 (Abuse Elevation Control Mechanism)",
                "Remediation": "Revoke IAM write permissions and implement Permission Boundaries."
            })
            
        return findings

# --- Execution ---
if __name__ == "__main__":
    detector = PrivilegeEscalationDetector()
    results = detector.scan_for_escalation()
    
    print("\n" + "🛡️ " * 15)
    print("      IAM PRIVILEGE ESCALATION REPORT")
    print("🛡️ " * 15)
    print(json.dumps(results, indent=4))

    # --- Real-time Security Alerts ---
    for res in results:
        if res['Status'] == "VULNERABLE":
            logging.critical(f"SECURITY BREACH RISK: User '{res['User']}' can elevate to Admin via {res['Vulnerable_Permissions']}!")