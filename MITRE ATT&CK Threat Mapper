    def audit_identity_threats(self):
        """Checks for MFA gaps - Mapped to MITRE T1078."""
        status = "CRITICAL" # Default if MFA is missing
        if MOCK_MODE:
            # Simulating MFA is disabled
            is_mfa_active = False
        else:
            summary = self.iam.get_account_summary()
            is_mfa_active = summary['SummaryMap'].get('AccountMFAEnabled', 0) == 1

        if is_mfa_active:
            return None # No threat found
        
        return {
            "Threat": "Root MFA Disabled",
            "MITRE_Tactic": "Initial Access / Persistence",
            "MITRE_Technique_ID": "T1078",
            "Description": "Attackers use valid credentials without MFA to gain persistent access."
        }

